# Project environment and Python/tool caches
.venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.idea/

# Downloaded data, provenance and incomplete downloads
data/raw/*
!data/raw/.gitkeep

# Experimental splits, staging folders and overwrite backups
data/processed/

